{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ULT Learning Progress Record",
  "type": "object",
  "required": ["ult_version", "project", "configuration", "scope", "topics", "session_state"],
  "properties": {
    "ult_version": {"type": "string", "const": "1.1"},
    "record_version": {"type": "string"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "project": {
      "type": "object",
      "required": ["title", "subject", "objective"],
      "properties": {
        "title": {"type": "string"},
        "subject": {"type": "string"},
        "objective": {"type": "string"},
        "deadline": {"type": ["string", "null"]},
        "start_date": {"type": ["string", "null"]}
      }
    },
    "configuration": {
      "type": "object",
      "properties": {
        "language": {"type": ["string", "null"]},
        "depth": {"type": ["string", "null"]},
        "teaching_style": {"type": ["string", "null"]},
        "guidance_mode": {"type": ["string", "null"]},
        "available_study_time": {"type": ["string", "null"]},
        "constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scope": {
      "type": "object",
      "required": ["authorization_level"],
      "properties": {
        "authorization_level": {"enum": ["A", "B", "C", "D"]},
        "allowed_sources": {"type": "array", "items": {"type": "string"}},
        "restrictions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "role": {"type": "string"},
          "sections": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"},
          "discrepancies": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "mastery_level"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["not_started", "in_progress", "completed"]},
          "mastery_level": {"type": "integer", "minimum": 0, "maximum": 5},
          "target_level": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {"type": "string"},
                "quality": {"enum": ["independent", "minor_prompt", "substantial_hint", "after_demonstration", "recalled_example"]},
                "date": {"type": ["string", "null"]},
                "result": {"type": ["string", "null"]}
              }
            }
          },
          "next_step": {"type": ["string", "null"]}
        }
      }
    },
    "mistake_profile": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pattern": {"type": "string"},
          "category": {"type": "string"},
          "likely_cause": {"type": "string"},
          "corrective_strategy": {"type": "string"},
          "status": {"type": "string"}
        }
      }
    },
    "revision_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {"type": "string"},
          "due": {"type": ["string", "null"]},
          "priority": {"type": "string"},
          "method": {"type": "string"}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {"type": "string"},
          "label": {"enum": ["INFERRED", "ASSUMED", "UNCERTAIN", "UNKNOWN", "CONFLICTING"]},
          "reason": {"type": "string"},
          "confidence": {"type": ["string", "null"]},
          "confirmation_required": {"type": "boolean"},
          "impact": {"type": "string"}
        }
      }
    },
    "session_state": {
      "type": "object",
      "required": ["last_completed_activity"],
      "properties": {
        "last_completed_activity": {"type": "string"},
        "current_topic": {"type": ["string", "null"]},
        "current_exercise": {"type": ["string", "null"]},
        "pending_question": {"type": ["string", "null"]},
        "next_action": {"type": ["string", "null"]},
        "session_summary": {"type": ["string", "null"]}
      }
    }
  }
}